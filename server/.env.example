# Prisma SQLite connection
DATABASE_URL="file:./dev.db"

# JWT signing secret.
# REQUIRED in production: must be >= 32 chars and not the dev default, or the
# server refuses to start. Generate one with:  openssl rand -base64 48
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Environment: set to "production" to enforce strict secret validation.
NODE_ENV="development"

# Allowed browser origin(s) for CORS, comma-separated. Defaults to the Vite dev server.
CLIENT_ORIGIN="http://localhost:3000"

# Server port
PORT=4000

# Default password applied to all seeded users (demo logins)
SEED_PASSWORD="password123"
